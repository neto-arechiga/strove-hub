// Strove Hub — reportes y operación de los sitios de clientes.
// Deploy: Cloudflare Workers Builds conectado a este repo (rama main).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "strove-hub",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "workers_dev": true,      // strove-hub.netoogare.workers.dev
  "preview_urls": false,    // sin URLs de vista previa del Hub

  // Logos de cada marca (public/logos/<slug>.png). Los que subes desde el Hub se guardan en la base.
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },  // para avisar cuando hay una versión nueva del Hub

  // Base de datos con todos los números y solicitudes.
  // Se crea en Cloudflare → Storage & Databases → D1 → Create ("strove-hub") y se pega aquí su ID.
  // Las tablas se crean solas al primer arranque.
  "services": [{ "binding": "SELF", "service": "strove-hub" }],
  "d1_databases": [
    { "binding": "DB", "database_name": "strove-hub", "database_id": "fa234bcf-2888-4d2d-bbac-b5a136910d46" }
  ],

  "triggers": {
    "crons": [
      "0 * * * *",   // cada hora: ¿el sitio está arriba?
      "0 10 * * *"   // 4:00 am Guadalajara: datos de GA4, Search Console y GitHub
    ]
  },

  "vars": {
    // Equipo de Cloudflare Zero Trust (lo que va antes de .cloudflareaccess.com)
    "ACCESS_TEAM": "shy-lake-b933",
    // Opcional: Audience (AUD) de la aplicación de Access, para una revisión extra.
    "ACCESS_AUD": "",
    // URL pública del Hub (para armar los links del formulario de clientes)
    "HUB_URL": "https://strove-hub.netoogare.workers.dev",
    // Dirección pública para los links de clientes (Worker strove-clientes, sin login)
    "CLIENT_URL": "https://strove-clientes.netoogare.workers.dev"
  }

  // Secretos (no van aquí, se cargan con `npx wrangler secret put NOMBRE`):
  //   GOOGLE_SA_KEY   JSON completo de la cuenta de servicio de Google
  //   GITHUB_TOKEN    token fine-grained de GitHub (Issues: lectura/escritura, Contents y Checks: lectura)
}
